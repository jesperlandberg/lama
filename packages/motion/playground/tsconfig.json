{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": "..",
    "baseUrl": "..",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "@webgpu/types"
    ],
    "paths": {
      "@domgl/motion": [
        "./src/index.ts"
      ]
    },
    "noUncheckedIndexedAccess": false
  },
  "include": [
    "./main.ts",
    "./carousel.ts",
    "../src"
  ]
}
