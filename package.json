  "scripts": {
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "@webgpu/types": "^0.1.72",
    "typescript": "^5",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
